{
  "name": "maxplus2-mcp",
  "version": "0.10.3",
  "private": true,
  "description": "MAX+plus II MCP 服务器：原理图、波形、编译仿真。Agent-independent MCP for Altera MaxPlus2: GDF/SYM/SCF editing, native compilation/simulation and standalone Windows automation.",
  "mcpName": "io.github.Hachimeder/maxplus2-mcp",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "maxplus2", "maxplus-ii", "altera", "fpga", "cpld", "eda", "digital-logic", "gdf", "sym", "scf", "ahdl", "vhdl", "verilog", "schematic", "waveform", "数字电路", "原理图", "波形仿真"],
  "type": "module",
  "main": "server.mjs",
  "bin": {
    "maxplus2-mcp": "server.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node run-all.mjs",
    "test:quick": "node run-all.mjs",
    "test:native": "node run-all.mjs --native",
    "test:desktop": "node test/desktop-native-e2e.mjs",
    "audit:public": "node scripts/audit-public.mjs",
    "package:release": "node scripts/package-release.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hachimeder/maxplus2-mcp.git"
  },
  "homepage": "https://github.com/Hachimeder/maxplus2-mcp#readme",
  "bugs": {
    "url": "https://github.com/Hachimeder/maxplus2-mcp/issues"
  }
}
